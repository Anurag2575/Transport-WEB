<h2><%= load.title %></h2>

<div class="load-details">
  <div class="load-info">
    <p><strong>Description:</strong> <%= load.description || 'No description provided' %></p>
    <p><strong>Origin:</strong> <%= load.origin %></p>
    <p><strong>Destination:</strong> <%= load.destination %></p>
    <p><strong>Weight:</strong> <%= load.weight ? load.weight + ' kg' : 'Not specified' %></p>
    <p><strong>Dimensions:</strong> <%= load.dimensions || 'Not specified' %></p>
    <p><strong>Value:</strong> <%= load.value ? '$' + load.value : 'Not specified' %></p>
    <p><strong>Posted by:</strong> <a href="/users/<%= load.postedBy._id %>"><%= load.postedBy.username %></a></p>
    <p><strong>Bidding ends:</strong> <%= load.biddingEndTime.toLocaleString() %></p>
    <p><strong>Status:</strong> <%= load.status %></p>
    <% if (load.status === 'bidding_closed' && !load.winner) { %>
      <p><strong>Bidding:</strong> Closed automatically. The load owner can now review bids and choose a winner manually.</p>
    <% } %>
  </div>

  <% if (load.status === 'open' && user && user._id.toString() !== load.postedBy._id.toString()) { %>
    <div class="bid-section">
      <h3>Place a Bid</h3>
      <form action="/bids/<%= load._id %>" method="POST">
        <div class="form-group">
          <label for="amount">Bid Amount ($)</label>
          <input type="number" id="amount" name="amount" step="0.01" required>
        </div>
        <div class="form-group">
          <label for="message">Message (optional)</label>
          <textarea id="message" name="message"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Place Bid</button>
      </form>
    </div>
  <% } %>

  <% if (['open', 'bidding_closed'].includes(load.status) && user && user._id.toString() === load.postedBy._id.toString() && !load.winner) { %>
    <div class="owner-actions">
      <h3>Owner Actions</h3>
      <% if (load.status === 'open') { %>
        <form action="/loads/<%= load._id %>/close-no-winner?_method=POST" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-danger" onclick="return confirm('Close without selecting winner?')">Close Bids</button>
        </form>
      <% } else { %>
        <form action="/loads/<%= load._id %>/close-no-winner?_method=POST" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-danger" onclick="return confirm('Close this load without selecting any winner?')">Close Without Winner</button>
        </form>
      <% } %>
      <% if (load.bids.length > 0) { %>
        <p>Select a winner from the bids below.</p>
      <% } %>
    </div>
  <% } %>

  <div class="bids-list">
    <h3>Bids (<%= load.bids.length %>)</h3>
    <% if (load.bids.length === 0) { %>
      <p>No bids yet.</p>
    <% } else { %>
      <% load.bids.forEach(bid => { %>
        <div class="bid-item">
          <p><strong>Bidder:</strong> <a href="/users/<%= bid.bidder._id %>"><%= bid.bidder.username %></a></p>
          <p><strong>Amount:</strong> $<%= bid.amount %></p>
          <p><strong>Complaints:</strong> <%= (bid.bidderComplaintsCount || bid.bidder.complaintsCount || 0) %></p>
          <% if (bid.hasComplaint) { %>
            <span class="badge bg-danger complaint-filed">Complaint Filed</span>
          <% } %>
          <p><strong>Message:</strong> <%= bid.message || 'No message' %></p>
          <p><strong>Status:</strong> <%= bid.status %></p>
          <% if (['open', 'bidding_closed'].includes(load.status) && user && user._id.toString() === load.postedBy._id.toString() && !load.winner) { %>
            <form action="/loads/<%= load._id %>/select-winner/<%= bid._id %>?_method=POST" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-success btn-small" onclick="return confirm('Select <%= bid.bidder.username %> as winner?')">Select Winner</button>
            </form>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
