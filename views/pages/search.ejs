<h2>Search Loads</h2>
<form action="/loads/search" method="GET" class="search-form">
  <div class="form-group">
    <label for="origin">Origin</label>
    <input type="text" id="origin" name="origin" placeholder="Enter origin city or leave blank">
  </div>
  <div class="form-group">
    <label for="destination">Destination</label>
    <input type="text" id="destination" name="destination" placeholder="Enter destination city or leave blank">
  </div>
  <button type="submit" class="btn btn-primary">Search</button>
</form>