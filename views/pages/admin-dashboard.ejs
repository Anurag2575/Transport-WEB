<%
  const verifiedCount = users.filter(user => user.isVerified).length;
  const activeCount = users.filter(user => user.isActive !== false).length;
  const adminCount = users.filter(user => user.isAdmin).length;
  const complaintCount = users.reduce((total, account) => total + (account.complaints ? account.complaints.length : 0), 0);
%>

<div class="admin-page container">
  <section class="admin-hero glass-card">
    <div class="admin-hero-copy">
      <span class="section-kicker">Admin Workspace</span>
      <h1>User Management</h1>
      <p>Review account health, verify new members, and activate or deactivate access from one place.</p>
    </div>
    <div class="admin-hero-actions">
      <a href="/users/admin/complaints" class="btn btn-primary">View Complaints</a>
      <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
  </section>

  <section class="admin-metrics">
    <article class="hero-stat-card">
      <span class="hero-stat-number"><%= users.length %></span>
      <span class="hero-stat-label">Total Users</span>
    </article>
    <article class="hero-stat-card">
      <span class="hero-stat-number"><%= activeCount %></span>
      <span class="hero-stat-label">Active Accounts</span>
    </article>
    <article class="hero-stat-card">
      <span class="hero-stat-number"><%= verifiedCount %></span>
      <span class="hero-stat-label">Verified Users</span>
    </article>
    <article class="hero-stat-card">
      <span class="hero-stat-number"><%= adminCount %></span>
      <span class="hero-stat-label">Admins</span>
    </article>
    <article class="hero-stat-card">
      <span class="hero-stat-number"><%= complaintCount %></span>
      <span class="hero-stat-label">Complaints Logged</span>
    </article>
  </section>

  <section class="profile-panel admin-panel">
    <div class="section-heading">
      <span class="section-kicker">Accounts</span>
      <h2>Manage users</h2>
      <p>Use the actions on each card to approve identities or control whether the account can sign in.</p>
    </div>

    <div class="admin-users-grid">
      <% users.forEach(account => { %>
        <% const complaintCountForUser = account.complaints ? account.complaints.length : 0; %>
        <article class="admin-user-card" data-user-id="<%= account._id %>">
          <div class="admin-user-top">
            <div class="admin-user-profile">
              <% if (account.photo) { %>
                <img src="/images/<%= account.photo %>" alt="<%= account.username %>" class="admin-user-photo">
              <% } else { %>
                <div class="user-photo-placeholder"><%= (account.username || 'U').charAt(0).toUpperCase() %></div>
              <% } %>

              <div class="admin-user-copy">
                <h3><%= account.username %></h3>
                <p><%= [account.firstName, account.lastName].filter(Boolean).join(' ') || 'No name provided' %></p>
                <span class="admin-user-email"><%= account.email %></span>
              </div>
            </div>

            <div class="admin-user-badges">
              <span class="badge <%= account.isVerified ? 'verified' : 'unverified' %> admin-verify-badge">
                <%= account.isVerified ? 'Verified' : 'Unverified' %>
              </span>
              <span class="badge <%= account.isActive !== false ? 'active' : 'inactive' %> admin-active-badge">
                <%= account.isActive !== false ? 'Active' : 'Deactivated' %>
              </span>
              <span class="badge <%= account.isAdmin ? 'admin' : 'user' %>">
                <%= account.isAdmin ? 'Admin' : 'User' %>
              </span>
            </div>
          </div>

          <div class="admin-user-meta">
            <div class="detail-metric-card">
              <span class="metric-label">Joined</span>
              <strong><%= account.joinDate.toLocaleDateString() %></strong>
            </div>
            <div class="detail-metric-card">
              <span class="metric-label">Account access</span>
              <strong class="admin-access-value"><%= account.isActive !== false ? 'Can log in' : 'Login blocked' %></strong>
            </div>
            <div class="detail-metric-card">
              <span class="metric-label">Complaints</span>
              <strong><%= complaintCountForUser %></strong>
            </div>
          </div>

          <div class="admin-user-actions">
            <% if (!account.isVerified) { %>
              <button class="btn btn-primary verify-btn" data-user-id="<%= account._id %>">Verify User</button>
            <% } else { %>
              <span class="admin-action-note">This user is already verified.</span>
            <% } %>

            <% if (user && user._id.toString() === account._id.toString()) { %>
              <span class="admin-action-note">Your own account cannot be deactivated.</span>
            <% } else { %>
              <button
                class="btn <%= account.isActive !== false ? 'btn-danger' : 'btn-success' %> toggle-active-btn"
                data-user-id="<%= account._id %>"
                data-is-active="<%= account.isActive !== false ? 'true' : 'false' %>"
              >
                <%= account.isActive !== false ? 'Deactivate Account' : 'Activate Account' %>
              </button>
            <% } %>
            <% if (complaintCountForUser > 0) { %>
              <a href="/users/admin/complaints?userId=<%= account._id %>" class="btn btn-secondary">Review Complaints</a>
            <% } else { %>
              <span class="admin-action-note">No complaints on record.</span>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const showAlert = (message, type) => {
      const alert = document.createElement('div');
      alert.className = `alert ${type === 'success' ? 'alert-success' : 'alert-error'}`;
      alert.textContent = message;

      const hero = document.querySelector('.admin-hero');
      hero.insertAdjacentElement('afterend', alert);

      setTimeout(() => alert.remove(), 3500);
    };

    document.querySelectorAll('.verify-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const userId = button.dataset.userId;
        button.disabled = true;
        button.textContent = 'Verifying...';

        try {
          const response = await fetch(`/users/admin/users/${userId}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          const data = await response.json();

          if (!data.success) {
            throw new Error(data.error || 'Unable to verify user');
          }

          const card = button.closest('.admin-user-card');
          const badge = card.querySelector('.admin-verify-badge');
          badge.textContent = 'Verified';
          badge.className = 'badge verified admin-verify-badge';
          button.replaceWith(Object.assign(document.createElement('span'), {
            className: 'admin-action-note',
            textContent: 'This user is already verified.'
          }));

          showAlert('User verified successfully.', 'success');
        } catch (error) {
          button.disabled = false;
          button.textContent = 'Verify User';
          showAlert(error.message, 'error');
        }
      });
    });

    document.querySelectorAll('.toggle-active-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const userId = button.dataset.userId;
        const isActive = button.dataset.isActive === 'true';
        const confirmed = confirm(
          isActive
            ? 'Deactivate this account? The user will no longer be able to log in.'
            : 'Activate this account so the user can log in again?'
        );

        if (!confirmed) return;

        button.disabled = true;
        button.textContent = isActive ? 'Deactivating...' : 'Activating...';

        try {
          const response = await fetch(`/users/admin/users/${userId}/toggle-active`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isActive: !isActive })
          });

          if (!response.ok) {
            const text = await response.text();
            try {
              const data = JSON.parse(text);
              throw new Error(data.error || 'Unable to update account');
            } catch (parseError) {
              throw new Error('Unable to update account');
            }
          }

          const data = await response.json();

          if (!data.success) {
            throw new Error(data.error || 'Unable to update account');
          }

          const card = button.closest('.admin-user-card');
          const badge = card.querySelector('.admin-active-badge');
          const accessValue = card.querySelector('.admin-access-value');
          const nextActive = data.isActive === true;

          badge.textContent = nextActive ? 'Active' : 'Deactivated';
          badge.className = `badge ${nextActive ? 'active' : 'inactive'} admin-active-badge`;
          accessValue.textContent = nextActive ? 'Can log in' : 'Login blocked';

          button.dataset.isActive = nextActive ? 'true' : 'false';
          button.className = `btn ${nextActive ? 'btn-danger' : 'btn-success'} toggle-active-btn`;
          button.textContent = nextActive ? 'Deactivate Account' : 'Activate Account';
          button.disabled = false;

          showAlert(
            nextActive ? 'Account activated successfully.' : 'Account deactivated successfully.',
            'success'
          );
        } catch (error) {
          button.disabled = false;
          button.textContent = isActive ? 'Deactivate Account' : 'Activate Account';
          showAlert(error.message, 'error');
        }
      });
    });
  });
</script>
