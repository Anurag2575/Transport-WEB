<h2>Upload Load</h2>
<form action="/loads/upload" method="POST">
  <div class="form-group">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" required>
  </div>
  <div class="form-group">
    <label for="description">Description</label>
    <textarea id="description" name="description"></textarea>
  </div>
  <div class="form-group">
    <label for="origin">Origin</label>
    <input type="text" id="origin" name="origin" required>
  </div>
  <div class="form-group">
    <label for="destination">Destination</label>
    <input type="text" id="destination" name="destination" required>
  </div>
  <div class="form-group">
    <label for="weight">Weight (kg)</label>
    <input type="number" id="weight" name="weight">
  </div>
  <div class="form-group">
    <label for="dimensions">Dimensions</label>
    <input type="text" id="dimensions" name="dimensions" placeholder="L x W x H">
  </div>
  <div class="form-group">
    <label for="value">Value ($)</label>
    <input type="number" id="value" name="value">
  </div>
  <div class="form-group">
    <label for="biddingHours">Bidding Duration (hours)</label>
    <input type="number" id="biddingHours" name="biddingHours" min="1" max="168" required>
  </div>
  <button type="submit" class="btn btn-primary">Upload Load</button>
</form>