<h2>My Posted Loads</h2>

<% if (!user || user.loadsPosted.length === 0) { %>
  <p>No loads posted yet.</p>
<% } else { %>
  <div class="loads-grid">
    <% user.loadsPosted.forEach(load => { %>
      <div class="load-card">
        <h3><%= load.title %></h3>
        <p><strong>Route:</strong> <%= load.origin %> → <%= load.destination %></p>
        <p><strong>Load Status:</strong> <span class="status-<%= load.status.replace('_', '-') %>"><%= load.status.replace('_', ' ') %></span></p>
        <p><strong>Bids:</strong> <%= load.bids ? load.bids.length : 0 %></p>
        <% if (load.bids && load.bids.length > 0) { %>
          <% const wonBid = load.bids.find(b => b.status === 'won'); %>
<% if (wonBid) { %>
            <p><strong>Winner:</strong> <%= wonBid.bidder.username %> ($<%= wonBid.amount %>)</p>
            <% if (wonBid.hasComplaint) { %>
              <span class="badge bg-danger complaint-filed">Complaint Filed</span>
            <% } else { %>
              <button type="button" class="btn btn-warning btn-small" data-bs-toggle="modal" data-bs-target="#complaintModal<%= load._id %>">File Complaint</button>
              
              <!-- Complaint Modal -->
              <div class="modal fade" id="complaintModal<%= load._id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">File Complaint Against <%= wonBid.bidder.username %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/loads/<%= load._id %>/complaint" method="POST">
                      <div class="modal-body">
                        <input type="hidden" name="loadId" value="<%= load._id %>">
                        <input type="hidden" name="bidderId" value="<%= wonBid.bidder._id %>">
                        <div class="mb-3">
                          <label for="title<%= load._id %>" class="form-label">Title</label>
                          <input type="text" class="form-control" id="title<%= load._id %>" name="title" required minlength="5">
                        </div>
                        <div class="mb-3">
                          <label for="desc<%= load._id %>" class="form-label">Description</label>
                          <textarea class="form-control" id="desc<%= load._id %>" name="description" rows="4" required minlength="10"></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">File Complaint</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% } %>
          <% } %>
        <% } %>
        <% if (load.winner) { %>
          <p><strong>Winner:</strong> <%= load.winner.username %></p>
        <% } else if (load.status === 'bidding_closed') { %>
          <p><strong>Winner:</strong> Pending manual selection</p>
        <% } %>
        <p><strong>Posted:</strong> <%= load.createdAt.toLocaleDateString() %></p>
        <a href="/loads/<%= load._id %>" class="btn btn-secondary">View Details</a>
        <% if (load.status === 'open') { %>
          <form action="/loads/<%= load._id %>/close-no-winner" method="POST" style="display: inline;">
            <button type="submit" class="btn btn-danger" onclick="return confirm('Close without selecting winner?')">Close without Winner</button>
          </form>
        <% } else if (load.status === 'bidding_closed' && !load.winner) { %>
          <p><strong>Next step:</strong> Open details to choose a winner manually.</p>
        <% } %>
      </div>
    <% }); %>
  </div>
<% } %>

<a href="/loads/upload" class="btn btn-primary">Post New Load</a>
