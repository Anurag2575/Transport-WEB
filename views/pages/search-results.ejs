<h2>Search Results</h2>
<p>Searching for loads from "<%= origin || 'anywhere' %>" to "<%= destination || 'anywhere' %>"</p>

<% if (loads.length === 0) { %>
  <p>No loads found matching your criteria.</p>
<% } else { %>
  <div class="loads-grid">
    <% loads.forEach(load => { %>
      <div class="load-card">
        <h3><%= load.title %></h3>
        <p><strong>From:</strong> <%= load.origin %></p>
        <p><strong>To:</strong> <%= load.destination %></p>
        <p><strong>Posted by:</strong> <%= load.postedBy.username %></p>
        <p><strong>Bidding ends:</strong> <%= load.biddingEndTime.toLocaleString() %></p>
        <a href="/loads/<%= load._id %>" class="btn btn-secondary">View Details</a>
      </div>
    <% }); %>
  </div>
<% } %>

<div class="search-again">
  <a href="/loads/search" class="btn btn-primary">New Search</a>
</div>